# Maintainer: Luke Kimball <kimballluke@gmail.com>
pkgname=omaseal-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="First-party Omarchy keyring manager (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/duketopceo/OmaSeal"
license=('MIT')
depends=('org.freedesktop.secrets')
optdepends=('fprintd: biometric unlock for the agent gate'
            'wl-clipboard: conditional clipboard clear (clipclear, panel copy)'
            'pinentry: GUI unlock prompt')
provides=('omaseal')
conflicts=('omaseal')
# These names match the tarballs published by .github/workflows/release.yml
# (omaseal-linux-x86_64.tar.gz / omaseal-linux-aarch64.tar.gz).
source_x86_64=("omaseal-linux-x86_64-${pkgver}.tar.gz::https://github.com/duketopceo/OmaSeal/releases/download/v${pkgver}/omaseal-linux-x86_64.tar.gz")
source_aarch64=("omaseal-linux-aarch64-${pkgver}.tar.gz::https://github.com/duketopceo/OmaSeal/releases/download/v${pkgver}/omaseal-linux-aarch64.tar.gz")
# Release archives are built in CI, so hashes cannot be known before the release
# is published. Run `packaging/aur/bump.sh vX.Y.Z` (or merge the CI bump PR)
# after each release — it updates these sums, pkgrel, install.sh's pins, and
# both .SRCINFO files together. updpkgsums alone leaves a half-bump. Do not
# publish this PKGBUILD with 'SKIP'.
sha256sums_x86_64=('f13ebeb996f8637a8cd55e300849e43e0008e6f2075298edf387aa8acb23f372')
sha256sums_aarch64=('9629b5ac287b3a5c2a092cd0881a7af5a26ce328a81893a02e6820d87f7cf1e6')
install=${pkgname}.install

package() {
  # The release tarball extracts to omaseal-linux-<arch>/ containing the binary
  # and plugin assets; enter it before installing.
  cd "omaseal-linux-${CARCH}"
  install -Dm755 omaseal "${pkgdir}/usr/bin/omaseal"
  # PluginRegistry scans ${OMARCHY_PATH}/shell/plugins (i.e. /usr/share/omarchy/shell/plugins)
  # for first-party plugins; the directory must be the manifest ID.
  local _plugindir="${pkgdir}/usr/share/omarchy/shell/plugins/io.github.duketopceo.omaseal"
  install -Dm644 BarWidget.qml Panel.qml PanelJobs.qml PanelModel.qml \
    SecretsView.qml AgentSection.qml AddEditForm.qml -t "${_plugindir}/"
  install -Dm644 manifest.json -t "${_plugindir}/"
  # Secret Service provider unit — deferred: v${pkgver} archives predate the
  # provider. Re-add once a tagged release ships contrib/omaseal-provider.service:
  # install -Dm644 omaseal-provider.service -t "${pkgdir}/usr/lib/systemd/user/"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
