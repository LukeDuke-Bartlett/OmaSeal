# Maintainer: Luke Kimball <kimballluke@gmail.com>
pkgname=omaseal
pkgver=0.4.0
pkgrel=1
pkgdesc="First-party Omarchy keyring manager"
arch=('x86_64' 'aarch64')
url="https://github.com/duketopceo/OmaSeal"
license=('MIT')
depends=('org.freedesktop.secrets')
optdepends=('fprintd: biometric unlock for the agent gate'
            'wl-clipboard: conditional clipboard clear (clipclear, panel copy)'
            'pinentry: GUI unlock prompt')
makedepends=('go')
conflicts=('omaseal-bin')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/duketopceo/OmaSeal/archive/refs/tags/v${pkgver}.tar.gz")
# The source is the immutable git-tag tarball. The SHA-256 can only be computed
# once the v${pkgver} tag is published; run `packaging/aur/bump.sh vX.Y.Z` (or
# merge the CI bump PR) after each release — it updates this sum, pkgrel,
# install.sh's pins, and both .SRCINFO files together. updpkgsums alone leaves
# a half-bump. Do not publish this PKGBUILD with 'SKIP'.
sha256sums=('fb29491e516d5334428260e40a9491e838ee3ef1bca1cc31aab22cc8744cd69a')
install=${pkgname}.install

build() {
  cd "OmaSeal-${pkgver}/engine"
  CGO_ENABLED=0 go build \
    -ldflags "-X main.version=v${pkgver} -X main.commit=unknown" \
    -o omaseal .
}

package() {
  cd "OmaSeal-${pkgver}"
  install -Dm755 "engine/omaseal" "${pkgdir}/usr/bin/omaseal"
  # PluginRegistry scans ${OMARCHY_PATH}/shell/plugins (i.e. /usr/share/omarchy/shell/plugins)
  # for first-party plugins; the directory must be the manifest ID.
  local _plugindir="${pkgdir}/usr/share/omarchy/shell/plugins/io.github.duketopceo.omaseal"
  install -Dm644 BarWidget.qml Panel.qml PanelJobs.qml PanelModel.qml \
    SecretsView.qml AgentSection.qml AddEditForm.qml -t "${_plugindir}/"
  install -Dm644 manifest.json -t "${_plugindir}/"
  # Secret Service provider unit — deferred: v${pkgver} archives predate the
  # provider. Re-add once a tagged release ships contrib/omaseal-provider.service:
  # install -Dm644 contrib/omaseal-provider.service -t "${pkgdir}/usr/lib/systemd/user/"
  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
